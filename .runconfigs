image_name: archetti/quail:0
container_name: {user}_quail_GPU{args.gpu}_{date}
docker_args: -p 8989:8888 -m 48G -v ~/quail/.local:/.local -v ~/quail/.cache:/.cache -v ~/quail/.config:/.config -v ~/storage_megaverse/quail/results:/exp/results -v ~/storage_megaverse/quail/data:/exp/data -v ~/storage_megaverse/quail/data_poisoned:/exp/data_poisoned